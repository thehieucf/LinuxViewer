# Arch Linux package built from this source tree:  cd packaging && makepkg -si
pkgname=linuxviewer
pkgver=0.1.0
pkgrel=1
pkgdesc="UltraViewer-compatible remote desktop client for Linux"
url='https://github.com/thehieucf/LinuxViewer'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gtk4' 'libadwaita' 'openssl' 'libjpeg-turbo' 'libpulse' 'libpipewire' 'xdg-desktop-portal')
makedepends=('cargo' 'clang' 'pkgconf')
optdepends=('ffmpeg: screen recording'
            'gnome-keyring: remember partner passwords (or any Secret Service provider)'
            'xdg-desktop-portal-gnome: screen sharing on GNOME'
            'xdg-desktop-portal-kde: screen sharing on KDE Plasma'
            'xdg-desktop-portal-wlr: screen sharing on sway/wlroots'
            'xdg-desktop-portal-hyprland: screen sharing on Hyprland')
options=('!lto')

_tree="$(realpath "$startdir/..")"

build() {
    cd "$_tree"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked -p linuxviewer
}

check() {
    cd "$_tree"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --release --locked --workspace
}

package() {
    cd "$_tree"
    BINARY="$srcdir/target/release/linuxviewer" PREFIX=/usr DESTDIR="$pkgdir" \
        UDEV_RULES_DIR=/usr/lib/udev/rules.d ./install.sh --system
}
